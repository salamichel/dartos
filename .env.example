POSTGRES_USER=dartos
POSTGRES_PASSWORD=dartos
POSTGRES_DB=dartos

PORT=3000
APP_PORT=8030

# Mot de passe admin pour les actions sensibles (supprimer/modifier saison ou match).
# Laisser vide pour désactiver la protection.
# ADMIN_PASSWORD=your-secret-password

# Firebase Configuration
# Chemin vers le fichier JSON de la clé du compte de service Firebase
FIREBASE_SERVICE_ACCOUNT_KEY=./firebase-service-account.json
